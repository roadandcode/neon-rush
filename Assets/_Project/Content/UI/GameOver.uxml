<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement class="backdrop" />
    <ui:VisualElement class="safe-area" picking-mode="Ignore">
        <ui:VisualElement class="centered" picking-mode="Ignore">
            <ui:VisualElement class="panel" picking-mode="Ignore">
                <ui:Label text="RUN OVER" class="heading heading--danger" picking-mode="Ignore" />
                <ui:Label name="game-over-new-best" text="NEW BEST" class="badge hidden" picking-mode="Ignore" />
                <ui:VisualElement name="game-over-score" class="digits digits--huge" picking-mode="Ignore" />

                <ui:VisualElement class="stat" picking-mode="Ignore">
                    <ui:Label text="BEST" class="stat__label" picking-mode="Ignore" />
                    <ui:VisualElement name="game-over-best" class="digits digits--medium" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement class="button-row" picking-mode="Ignore">
                    <ui:Button name="game-over-retry" text="RUN AGAIN" class="button button--primary" focusable="false" />
                    <ui:Button name="game-over-menu" text="MENU" class="button" focusable="false" />
                </ui:VisualElement>

                <ui:VisualElement class="hints" picking-mode="Ignore">
                    <ui:VisualElement class="hint hint--keyboard" picking-mode="Ignore">
                        <ui:Label text="ENTER" class="key" picking-mode="Ignore" />
                        <ui:Label text="run again" class="hint__text" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hint hint--gamepad" picking-mode="Ignore">
                        <ui:Label text="A" class="key" picking-mode="Ignore" />
                        <ui:Label text="run again" class="hint__text" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
