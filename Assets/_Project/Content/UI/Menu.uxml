<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!--
        The title screen has no backdrop: the scene behind it is the picture. The camera frames
        the runner on the right of the screen, so everything here keeps to the left half.
    -->
    <ui:VisualElement class="safe-area" picking-mode="Ignore">
        <ui:VisualElement class="menu" picking-mode="Ignore">
            <ui:Label text="NEON" class="title" picking-mode="Ignore" />
            <ui:Label text="RUSH" class="title title--second" picking-mode="Ignore" />
            <ui:Label text="THREE LANES. NO BRAKES." class="tagline" picking-mode="Ignore" />

            <ui:VisualElement class="stat" picking-mode="Ignore">
                <ui:Label text="BEST" class="stat__label" picking-mode="Ignore" />
                <ui:VisualElement name="menu-best" class="digits digits--medium" picking-mode="Ignore" />
            </ui:VisualElement>

            <ui:Button name="menu-play" text="PLAY" class="button button--primary" focusable="false" />

            <ui:Button class="sound-toggle" focusable="false">
                <ui:Label text="SOUND ON" class="sound-toggle__on" picking-mode="Ignore" />
                <ui:Label text="SOUND OFF" class="sound-toggle__off" picking-mode="Ignore" />
            </ui:Button>

            <!-- One row per control scheme. The platform's input profile decides which rows show. -->
            <ui:VisualElement class="hints" picking-mode="Ignore">
                <ui:VisualElement class="hint hint--keyboard" picking-mode="Ignore">
                    <ui:Label text="A" class="key" picking-mode="Ignore" />
                    <ui:Label text="D" class="key key--joined" picking-mode="Ignore" />
                    <ui:Label text="lane" class="hint__text" picking-mode="Ignore" />
                    <ui:Label text="W" class="key" picking-mode="Ignore" />
                    <ui:Label text="jump" class="hint__text" picking-mode="Ignore" />
                    <ui:Label text="S" class="key" picking-mode="Ignore" />
                    <ui:Label text="slide" class="hint__text" picking-mode="Ignore" />
                    <ui:Label text="ENTER" class="key" picking-mode="Ignore" />
                    <ui:Label text="start" class="hint__text" picking-mode="Ignore" />
                    <ui:Label text="ESC" class="key" picking-mode="Ignore" />
                    <ui:Label text="pause" class="hint__text" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="hint hint--gamepad" picking-mode="Ignore">
                    <ui:Label text="D-PAD" class="key" picking-mode="Ignore" />
                    <ui:Label text="lane" class="hint__text" picking-mode="Ignore" />
                    <ui:Label text="A" class="key" picking-mode="Ignore" />
                    <ui:Label text="jump" class="hint__text" picking-mode="Ignore" />
                    <ui:Label text="B" class="key" picking-mode="Ignore" />
                    <ui:Label text="slide" class="hint__text" picking-mode="Ignore" />
                    <ui:Label text="START" class="key" picking-mode="Ignore" />
                    <ui:Label text="pause" class="hint__text" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="hint hint--pointer" picking-mode="Ignore">
                    <ui:Label text="SWIPE SIDEWAYS" class="key" picking-mode="Ignore" />
                    <ui:Label text="lane" class="hint__text" picking-mode="Ignore" />
                    <ui:Label text="SWIPE UP" class="key" picking-mode="Ignore" />
                    <ui:Label text="jump" class="hint__text" picking-mode="Ignore" />
                    <ui:Label text="SWIPE DOWN" class="key" picking-mode="Ignore" />
                    <ui:Label text="slide" class="hint__text" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
